{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ateam",
  "version": "0.8.0",
  "identifier": "dev.ateam.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @ateam/desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter @ateam/desktop-ui build && pnpm --filter @ateam/sidecar build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ateam",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNUJBMDE0QkE3NzdENEEKUldSS2ZYZTZGS0JiTTBCclhPZEFkUjhEVnJpb2FLcm1IWnNMWTdFTnovTmRSK0kzQ0NFZ3FTT2IK",
      "endpoints": ["https://relay.kidsmath.icu:27443/update/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "../../sidecar/dist": "sidecar" },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
