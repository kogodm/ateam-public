<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Default notification presentation: "alert" = stays on screen until
	     dismissed (vs "banner" which auto-fades). The user can still override
	     per-app in System Settings → Notifications. -->
	<key>NSUserNotificationAlertStyle</key>
	<string>alert</string>
</dict>
</plist>
